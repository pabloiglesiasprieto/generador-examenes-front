{
  "expo": {
    "name": "Generador Examenes",
    "slug": "generador-examenes-front",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0D0D1A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.proyecto.generadorexamenes",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.proyecto.generadorexamenes",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0D1A"
      },
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "b56c7eca-6fc3-4481-919f-6071e459055d"
      }
    },
    "owner": "pabloiglesiasprieto"
  }
}
